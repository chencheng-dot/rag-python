# ===== PostgreSQL + pgvector（docker compose 起的就是下面这套）=====
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DB=rag_db
PG_USER=rag
PG_PASSWORD=rag_pwd
PG_COLLECTION=kb_chunks

# ===== 文本模型 / 向量模型（OpenAI 兼容协议）=====
# 默认指向阿里云 Dashscope 兼容模式，也可换成任何 OpenAI 兼容端点
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=
CHAT_MODEL=qwen-plus
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
# 必须与所用向量模型输出维度一致，否则建表/检索会报维度不匹配
EMBEDDING_DIMS=1024

# ===== 重排（Dashscope text-rerank）=====
RERANK_ENABLED=true
RERANK_BASE_URL=https://dashscope.aliyuncs.com
RERANK_API_KEY=
RERANK_MODEL=qwen3.7-text-rerank

# ===== 查询改写（仅模糊问题触发，改写句只用于 embedding）=====
REWRITE_ENABLED=true

# ===== 生成约束：相似度模式与单块截断 =====
# precise=0.7（默认） / broad=0.6
SIMILARITY_MODE=precise
CHUNK_MAX_CHARS=800

# ===== 切片与检索参数 =====
# 切片方式：char（默认）/ paragraph / section
CHUNK_MODE=char
CHUNK_SIZE=500
CHUNK_OVERLAP=80
RETRIEVE_TOP_N=20
RERANK_TOP_K=5
MAX_CONTEXT_CHARS=6000
